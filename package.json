{
  "name": "regops-pilot-device",
  "version": "0.2.0",
  "private": true,
  "description": "A tiny, fictional medical-device software component used as a pilot source repository for RegOps (RegBuild adapters). Not a real device.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:ci": "vitest run --reporter=default --reporter=junit --outputFile.junit=reports/junit.xml"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "minimist": "1.2.0"
  }
}
